
-- קביעת אזור הזמן של ה-DB לזמן ישראל
ALTER DATABASE swapify SET timezone TO 'Asia/Jerusalem';

-- הוספת הרחבה להצפנה
CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- יצירת ENUMs
CREATE TYPE request_status AS ENUM ('Pending', 'Approved', 'Completed', 'Rejected');
CREATE TYPE user_report_status AS ENUM ('Open', 'Under Review', 'Closed');
CREATE TYPE exchange_status AS ENUM ('Completed', 'Pending', 'Rejected');
CREATE TYPE subcategory_puzzle AS ENUM ('Nature', 'Art', 'Kids', '3 D');
CREATE TYPE subcategory_book AS ENUM ('Romance', 'Thriller', 'Fantasy', 'Sci-Fi', 'Children', 'Non-fiction', 'Biography', 'Textbook');
CREATE TYPE subcategory_board_game AS ENUM ('Strategy', 'Kids', 'Party', 'Puzzle', 'Two-player', 'Group', 'Family');
CREATE TYPE role_names AS ENUM ('Admin', 'Guest', 'User');
CREATE TYPE availability_status AS ENUM ('Available','Interested', 'Pending', 'Exchanged');
CREATE TYPE notification_status AS ENUM ('Unread', 'Read');
CREATE TYPE notification_type AS ENUM ('new_request',       -- קיבלת בקשת החלפה
  'approved',          -- הבקשה שלך אושרה
  'rejected',          -- הבקשה שלך נדחתה
  'auto_rejected',     -- הבקשה שלך נדחתה אוטומטית
  'match_found',       -- נמצאה התאמה בין בקשות
  'new_message',       -- הודעה חדשה בצ'אט (בעתיד)
  'info'               -- התראה כללית
);
-- טבלת Roles
CREATE TABLE IF NOT EXISTS Roles (
    Role_id SERIAL PRIMARY KEY,
    Role_name role_names NOT NULL UNIQUE
);

-- הכנסת תפקידים למערכת
INSERT INTO Roles (role_name) VALUES ('Guest'), ('User'), ('Admin') ON CONFLICT DO NOTHING;

-- טבלת Users
CREATE TABLE IF NOT EXISTS Users (
    User_id SERIAL PRIMARY KEY,
    Name VARCHAR (100) NOT NULL,
    Email VARCHAR (255) NOT NULL UNIQUE,
    Password_hash VARCHAR (255),
    Profile_picture VARCHAR (255),
    Location VARCHAR (100),
    Auth_provider VARCHAR (100) CHECK (Auth_provider IN ('Facebook', 'Google', 'Regular')) NOT NULL DEFAULT 'Regular',
    Role_id INT NOT NULL,
    Notification_enabled BOOLEAN DEFAULT TRUE,
    Is_banned BOOLEAN DEFAULT FALSE,
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_role FOREIGN KEY (role_id) REFERENCES Roles (role_id) ON DELETE RESTRICT
);

-- טבלת Products
CREATE TABLE IF NOT EXISTS Products (
    Product_id SERIAL PRIMARY KEY,
    User_id INT REFERENCES Users (user_id) ON DELETE CASCADE,
    Title VARCHAR (255) NOT NULL,
    Description TEXT NOT NULL,
    Category VARCHAR (50) NOT NULL,
    Subcategory VARCHAR (255),
    Condition VARCHAR (50) CHECK (condition IN ('New', 'Used', 'Good Condition')),
    Location VARCHAR (255),
    Image_url TEXT,
    Availability availability_status DEFAULT 'Available',
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- טבלאות מוצרי משנה
CREATE TABLE IF NOT EXISTS Puzzles (
    Product_id INT PRIMARY KEY REFERENCES Products (product_id) ON DELETE CASCADE,
    Manufacturer VARCHAR (255),
    Pieces_count INT,
    Image_url TEXT,
    Subcategory subcategory_puzzle
);

CREATE TABLE IF NOT EXISTS Books (
    Product_id INT PRIMARY KEY REFERENCES Products (product_id) ON DELETE CASCADE,
    Author VARCHAR (255),
    Publish_year INT,
    Publisher VARCHAR (255),
    Page_count INT,
    Image_url TEXT,
    Subcategory subcategory_book
);

CREATE TABLE IF NOT EXISTS Board_Games (
    Product_id INT PRIMARY KEY REFERENCES Products (product_id) ON DELETE CASCADE,
    Min_players INT,
    Max_players INT,
    Duration INT,
    Image_url TEXT,
    Subcategory subcategory_board_game
);

-- בקשות החלפה
CREATE TABLE IF NOT EXISTS Exchange_Requests (
    Request_id SERIAL PRIMARY KEY,
    User_id INT REFERENCES Users (user_id), ----יוזם ההצעה
    Product_id INT REFERENCES Products (product_id), --מקבל--
    Status request_status,
    chosen_product_id INT REFERENCES Products(product_id), ----של יוזם ההצעה
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Chat_id INT
);

-- הצעות החלפה (ריבוי מוצרים)
CREATE TABLE IF NOT EXISTS Exchange_Proposal_Options (
    Option_id SERIAL PRIMARY KEY,
    Request_id INT REFERENCES Exchange_Requests (Request_id) ON DELETE CASCADE,
    Offered_product_id INT REFERENCES Products (product_id) ON DELETE CASCADE
);

-- בקשות מידע
CREATE TABLE IF NOT EXISTS Product_Information_Requests (
    Request_id SERIAL PRIMARY KEY,
    User_id INT REFERENCES Users (user_id),
    Product_id INT REFERENCES Products (product_id),
    Message TEXT,
    Status request_status,
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- טבלת התראות
CREATE TABLE IF NOT EXISTS Notifications (
    notification_id SERIAL PRIMARY KEY,
    user_id INT REFERENCES Users (user_id) ON DELETE CASCADE,
    type notification_type NOT NULL,
    message TEXT NOT NULL,
    context_id INT, -- מזהה רלוונטי (בקשה, מוצר, הודעה וכו')
    status notification_status DEFAULT 'Unread',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- טבלת צ'אטים
CREATE TABLE IF NOT EXISTS Chats (
    Chat_id SERIAL PRIMARY KEY,
    Exchange_request_id INT NOT NULL REFERENCES Exchange_Requests (Request_id) ON DELETE CASCADE,
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE IF NOT EXISTS Messages (
    Message_id SERIAL PRIMARY KEY,
    Chat_id INT NOT NULL REFERENCES Chats(Chat_id) ON DELETE CASCADE,
    Sender_id INT NOT NULL REFERENCES Users(User_id) ON DELETE CASCADE,
    Type TEXT NOT NULL DEFAULT 'text' CHECK (
        Type IN ('text', 'system')
    ),
    Content TEXT,
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    read_at TIMESTAMPTZ DEFAULT NULL
);


-- דיווחי משתמשים
CREATE TABLE IF NOT EXISTS User_Reports (
    Report_id SERIAL PRIMARY KEY,
    Reported_user_id INT REFERENCES Users (user_id),
    User_id INT REFERENCES Users (user_id),
    Report_reason TEXT,
    Status user_report_status,
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- היסטוריית החלפות
CREATE TABLE IF NOT EXISTS Exchange_History (
    Exchange_id SERIAL PRIMARY KEY,
    User_id INT REFERENCES Users (user_id),
    Exchange_product_id INT REFERENCES Products (product_id),
    Received_product_id INT REFERENCES Products (product_id),
    Exchange_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Rating_given INT CHECK (rating_given BETWEEN 1 AND 5),
    Rating_received INT CHECK (rating_received BETWEEN 1 AND 5),
    Status exchange_status
);

-- לוג פעולות
CREATE TABLE IF NOT EXISTS Audit_Logs (
    Log_id SERIAL PRIMARY KEY,
    Action VARCHAR (255),
    User_id INT REFERENCES Users (user_id),
    User_name VARCHAR (100),
    Timestamp TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Details TEXT
);

-- עמוד אודות
CREATE TABLE IF NOT EXISTS About_Sections (
    Section_id SERIAL PRIMARY KEY,
    Title TEXT,
    Content TEXT,
    Updated_by TEXT,
    CHECK (Title IS NOT NULL OR Content IS NOT NULL)
);

CREATE TABLE IF NOT EXISTS Cross_Exchange_Matches (
    Match_id SERIAL PRIMARY KEY,
    Request_a_id INT NOT NULL REFERENCES Exchange_Requests(request_id) ON DELETE CASCADE,
    Request_b_id INT NOT NULL REFERENCES Exchange_Requests(request_id) ON DELETE CASCADE,
    Created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    Is_active BOOLEAN DEFAULT TRUE,
    UNIQUE (Request_a_id, Request_b_id)
);


